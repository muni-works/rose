[part "U6" "Driver_FET:UCC27511ADBV" "UCC27511A" "Package_TO_SOT_SMD:SOT-23-6"
  #["1" "+12V" "4" "GND" "6" "BRK_IN" "5" "GND" "2" "BRK_GH" "3" "BRK_GL"]]
[r "R22" "4.7" "BRK_GH" "BRK_G"]
[r "R23" "2.2" "BRK_GL" "BRK_G"]
[c "C9" "1u" "+12V" "GND"]
[part "Q2" "Transistor_FET:IPT015N10N5" "IPT015N10N5 100V 1.5mR" "Package_TO_SOT_SMD:Infineon_PG-HSOF-8-1"
  #["1" "BRK_G" "2" "GND" "3" "BRK_R"]]
[part "D4" "Device:D_Schottky" "STPS10H100 100V" "Diode_SMD:D_SMC"
