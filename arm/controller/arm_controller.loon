[r "R25" "10k" "+3V3" "NTC_BRK"]

;; ---- logic rails: 48 V -> 12 V -> 5 V -> 3.3 V

[part "U7" "Regulator_Switching:LM5164DDA" "LM5164 48V->12V" "Package_SO:Texas_HSOP-8-1EP_3.9x4.9mm_P1.27mm"
  #["2" "VIN_BUCK" "3" "BK1_EN" "4" "BK1_RON" "1" "GND" "9" "GND" "7" "BK1_BST" "8" "BK1_SW" "5" "BK1_FB" "6" "BK1_PG"]]
