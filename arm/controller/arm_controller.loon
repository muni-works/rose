  #["D" "VIN" "G" "HS_GATE" "S" "VBUS_SW"]]
[r "R3" "220k" "VIN" "HS_UVLO"]
[r "R4" "10k" "HS_UVLO" "GND"]
[r "R5" "330k" "VIN" "HS_OVP"]
[r "R6" "10k" "HS_OVP" "GND"]
[c "C2" "100n" "HS_TIMER" "GND"]
[r "R7" "10k" "+3V3" "HS_PGD"]
[part "U2" "74xGxx:74LVC1G11" "74LVC1G11" "Package_TO_SOT_SMD:SOT-23-6"
  #["1" "ESTOP1" "3" "WD_OK" "6" "MCU_EN" "4" "EN_AND" "5" "+3V3" "2" "GND"]]
[r "R8" "1M" "EN_AND" "HS_EN"]
[c "C3" "390n" "HS_EN" "GND"]
;; D10 bypasses R8: C3 charges at once, so the e-stop hold is a fixed ~190 ms (sim/)
[part "D10" "Device:D_Schottky" "BAT54" "Diode_SMD:D_SOD-123"
  #["2" "EN_AND" "1" "HS_EN"]]
[part "J2" "Connector_Generic:Conn_01x04" "E-stop, 2-ch NC" "Connector_JST:JST_GH_SM04B-GHS-TB_1x04-1MP_P1.25mm_Horizontal"
  #["1" "ESTOP_SRC1" "2" "ESTOP1" "3" "ESTOP_SRC2" "4" "ESTOP2"]]
[r "R9" "1k" "+3V3" "ESTOP_SRC1"]
[r "R10" "10k" "ESTOP1" "GND"]
[r "R11" "1k" "+3V3" "ESTOP_SRC2"]
[r "R12" "10k" "ESTOP2" "GND"]
[part "U3" "Power_Supervisor:TPS3430WDRC" "TPS3430" "Package_SON:Texas_DRC0010J_ThermalVias"
  #["1" "+3V3" "10" "+3V3" "5" "GND" "11" "GND" "7" "WD_KICK" "4" "WD_CRST" "2" "WD_CWD" "3" "GND" "6" "GND" "8" "WD_OK"]]
[c "C4" "10n" "WD_CRST" "GND"]
[c "C5" "10n" "WD_CWD" "GND"]
[r "R13" "10k" "+3V3" "WD_OK"]
[flag "PF1" "VIN"]
[flag "PF2" "GND"]

