[part "D2" "Device:D_Schottky" "BAT54" "Diode_SMD:D_SOD-123"
  #["2" "BRK_CMP" "1" "BRK_IN"]]
[part "D3" "Device:D_Schottky" "BAT54" "Diode_SMD:D_SOD-123"
  #["2" "BRK_FORCE" "1" "BRK_IN"]]
