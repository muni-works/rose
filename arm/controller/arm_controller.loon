;; rose arm controller v0.1 - the circuit as loon.
;;
;; Every part is a KiCad library symbol: [EcadSymbol ref "Library:Symbol" value footprint x y rot],
;; so pin numbers and names come from KiCad's own libraries. Connectivity is data:
;; [EcadConn net "REF.PIN"]. Design notes: DESIGN.md. Render:
;;   vcad export arm_controller.loon arm_controller.kicad_sch
;;   kicad-cli sch erc arm_controller.kicad_sch

[let R0402 "Resistor_SMD:R_0402_1005Metric"]
[let C0402 "Capacitor_SMD:C_0402_1005Metric"]
[let C0805 "Capacitor_SMD:C_0805_2012Metric"]
[let C1210 "Capacitor_SMD:C_1210_3225Metric"]
[let R2512 "Resistor_SMD:R_2512_6332Metric"]

;; a part and its connections; pins is flat: #["pin" "net" "pin" "net" ...]
[let part [fn [ref lib val fp pins]
  #[[EcadSymbol ref lib val fp 0.0 0.0 0.0]
    [map [fn [pn] [EcadConn [nth pn 1] [str ref "." [nth pn 0]]]] [chunk 2 pins]]]]]
[let r [fn [ref val a b] [part ref "Device:R" val R0402 #["1" a "2" b]]]]
[let c [fn [ref val a b] [part ref "Device:C" val C0402 #["1" a "2" b]]]]
[let cfp [fn [ref val fp a b] [part ref "Device:C" val fp #["1" a "2" b]]]]
[let flag [fn [ref net] [part ref "power:PWR_FLAG" "PWR_FLAG" "" #["1" net]]]]


;; ---- power in, hot-swap switch, e-stop and watchdog

[part "J1" "Connector_Generic:Conn_01x02" "XT60PW-M 48V in" "Connector_AMASS:AMASS_XT60PW-M_1x02_P7.20mm_Horizontal"
  #["1" "VIN_RAW" "2" "GND"]]
