[flag "PF4" "+12V"]
[flag "PF5" "+5V"]
[part "D5" "Device:LED" "green 3V3" "LED_SMD:LED_0603_1608Metric"
  #["2" "LED_PWR" "1" "GND"]]
[r "R35" "1k" "+3V3" "LED_PWR"]

