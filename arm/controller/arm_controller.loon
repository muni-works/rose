[r "R60" "10k" "+3V3" "ETH_RXD1"]
[r "R61" "10k" "+3V3" "ETH_CRSDV"]
[r "R62" "1.5k" "+3V3" "ETH_MDIO"]
[r "R63" "49.9 1%" "ETH_CT" "ETH_TXP"]
[r "R64" "49.9 1%" "ETH_CT" "ETH_TXN"]
[r "R65" "49.9 1%" "ETH_CT" "ETH_RXP"]
[r "R66" "49.9 1%" "ETH_CT" "ETH_RXN"]
[part "FB3" "Device:FerriteBead_Small" "600R@100MHz" "Inductor_SMD:L_0603_1608Metric"
  #["1" "+3V3" "2" "ETH_CT"]]
