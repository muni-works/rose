[flag "PF10" "ETH_CT"]
[part "J13" "Connector:RJ45_Hanrun_HR911105A_Horizontal" "HR911105A" "Connector_RJ:RJ45_Hanrun_HR911105A_Horizontal"
  #["1" "ETH_TXP" "2" "ETH_TXN" "3" "ETH_RXP" "6" "ETH_RXN" "4" "ETH_CT" "5" "ETH_CT" "8" "GND" "SH" "GND"]]

;; ---- limb options: one board for arm, leg, torso (DESIGN.md "One board, many limbs")
;; Every block below is optional at assembly (leave it unpopulated where a limb doesn't need it).

;; board ID: firmware reads the divider and boots as arm / leg / torso / head
[r "R67" "10k" "+3V3" "BOARD_ID"]
[r "R68" "ID: DNP arm, 10k leg, 4.7k torso, 2.2k head" "BOARD_ID" "GND"]
[c "C48" "100n" "BOARD_ID" "GND"]

;; SPI1 bus: IMU, load-cell ADC, fourth CAN-FD
[part "U16" "Sensor_Motion:ISM330DHCX" "ISM330DHCX" "Package_LGA:LGA-14_3x2.5mm_P0.5mm_LayoutBorder3x4y"
  #["13" "SPI_SCK" "14" "SPI_MOSI" "1" "IMU_SDO" "12" "IMU_CS" "4" "IMU_INT" "8" "+3V3" "5" "+3V3" "6" "GND" "7" "GND" "2" "GND" "3" "GND"]]
[c "C49" "100n" "+3V3" "GND"]
[r "R75" "33" "IMU_SDO" "SPI_MISO"]
[c "C50" "100n" "+3V3" "GND"]

;; load cell / force sensor: ratiometric bridge, 24 bit
[part "U17" "Analog_ADC:ADS1220xPW" "ADS1220IPW" "Package_SO:TSSOP-16_4.4x5mm_P0.65mm"
  #["1" "SPI_SCK" "16" "SPI_MOSI" "15" "ADC_DOUT" "2" "ADC_CS" "14" "ADC_DRDY" "3" "GND" "13" "+3V3" "4" "GND" "12" "AVDD_LC" "5" "GND" "9" "AVDD_LC" "8" "GND" "11" "LC_SP" "10" "LC_SN"]]
[part "FB5" "Device:FerriteBead_Small" "600R@100MHz" "Inductor_SMD:L_0603_1608Metric"
  #["1" "+3V3" "2" "AVDD_LC"]]
[c "C51" "1u" "AVDD_LC" "GND"]
[c "C52" "100n" "AVDD_LC" "GND"]
[c "C53" "100n" "+3V3" "GND"]
[r "R76" "33" "ADC_DOUT" "SPI_MISO"]
[r "R69" "1k" "LC_P" "LC_SP"]
[r "R70" "1k" "LC_N" "LC_SN"]
[c "C54" "10n" "LC_SP" "LC_SN"]
[c "C55" "1n" "LC_SP" "GND"]
[c "C56" "1n" "LC_SN" "GND"]
[flag "PF12" "AVDD_LC"]
[part "J14" "Connector_Generic:Conn_01x04" "GH load cell EXC+/EXC-/S+/S-" "Connector_JST:JST_GH_SM04B-GHS-TB_1x04-1MP_P1.25mm_Horizontal"
  #["1" "AVDD_LC" "2" "GND" "3" "LC_P" "4" "LC_N"]]

;; fourth CAN-FD bus (the MCU's three FDCANs are taken): SPI controller + transceiver in one
[part "U18" "Interface_CAN_LIN:MCP251863T-E-9PX" "MCP251863T-E/9PX" "Package_DFN_QFN:VQFN-28-1EP_5x5mm_P0.5mm_EP3.25x3.25mm"
  #["25" "CANX_CS" "22" "SPI_SCK" "23" "SPI_MOSI" "24" "SPI_MISO" "3" "CANX_INT" "5" "CANX_OSC1" "4" "CANX_OSC2" "14" "+3V3" "26" "+3V3" "13" "+5V" "10" "GND" "7" "GND" "29" "GND" "18" "CANX_STBY" "17" "CANX_H" "16" "CANX_L" "20" "CANX_TXD" "28" "CANX_TXI" "11" "CANX_RXI" "1" "CANX_RXI"]]
[part "Y3" "Device:Crystal_GND24" "40MHz" "Crystal:Crystal_SMD_3225-4Pin_3.2x2.5mm"
  #["1" "CANX_OSC1" "3" "CANX_OSC2" "2" "GND" "4" "GND"]]
[c "C57" "12p" "CANX_OSC1" "GND"]
[c "C58" "12p" "CANX_OSC2" "GND"]
[c "C59" "100n" "+3V3" "GND"]
[c "C60" "100n" "+3V3" "GND"]
[c "C61" "100n" "+5V" "GND"]
[r "R71" "10k" "CANX_STBY" "GND"]
[r "R77" "0" "CANX_TXI" "CANX_TXD"]
[r "R72" "60.4" "CANX_H" "CANX_TSPLIT"]
[r "R73" "60.4" "CANX_TSPLIT" "CANX_L"]
[c "C62" "4.7n" "CANX_TSPLIT" "GND"]
[part "D11" "Device:D_TVS_Dual_AAC" "PESD2CAN" "Package_TO_SOT_SMD:SOT-23"
  #["1" "CANX_H" "2" "CANX_L" "3" "GND"]]
[part "J15" "Connector_Generic:Conn_01x03" "GH CAN-FD X (second limb / tool)" "Connector_JST:JST_GH_SM03B-GHS-TB_1x03-1MP_P1.25mm_Horizontal"
  #["1" "CANX_H" "2" "CANX_L" "3" "GND"]]

;; brushed DC motor (gripper / tool), from 12 V; ILIM 82k = 0.78 A, inside the 12 V buck's 1 A
[part "U19" "Driver_Motor:DRV8871DDA" "DRV8871DDAR" "Package_SO:Texas_HTSOP-8-1EP_3.9x4.9mm_P1.27mm_EP2.95x4.9mm_Mask2.4x3.1mm_ThermalVias"
  #["3" "MOT_IN1" "2" "MOT_IN2" "5" "+12V" "1" "GND" "7" "GND" "9" "GND" "6" "MOT_A" "8" "MOT_B" "4" "MOT_ILIM"]]
[r "R74" "82k" "MOT_ILIM" "GND"]
[cfp "C63" "10u 25V" C1210 "+12V" "GND"]
[c "C64" "100n" "+12V" "GND"]
[part "J16" "Connector_Generic:Conn_01x02" "GH brushed motor" "Connector_JST:JST_GH_SM02B-GHS-TB_1x02-1MP_P1.25mm_Horizontal"
  #["1" "MOT_A" "2" "MOT_B"]]

;; second fused 48 V output: this board is also the power distribution node
[part "F1" "Device:Polyfuse" "PTC 60V 3A hold (Bourns MF-SM, verify part)" "Fuse:Fuse_2920_7451Metric"
  #["1" "VBUS" "2" "VAUX48"]]
[part "J17" "Connector_Generic:Conn_01x02" "XT30PW-M 48 V aux out" "Connector_AMASS:AMASS_XT30PW-M_1x02_P2.50mm_Horizontal"
  #["1" "VAUX48" "2" "GND"]]

;; mounting: M3 at the corners, grounded, so the board fits any limb, not only the foot
[part "H1" "Mechanical:MountingHole_Pad" "M3" "MountingHole:MountingHole_3.2mm_M3_Pad_Via"
  #["1" "GND"]]
[part "H2" "Mechanical:MountingHole_Pad" "M3" "MountingHole:MountingHole_3.2mm_M3_Pad_Via"
  #["1" "GND"]]
[part "H3" "Mechanical:MountingHole_Pad" "M3" "MountingHole:MountingHole_3.2mm_M3_Pad_Via"
  #["1" "GND"]]
[part "H4" "Mechanical:MountingHole_Pad" "M3" "MountingHole:MountingHole_3.2mm_M3_Pad_Via"
  #["1" "GND"]]

;; ---- placement (place.py)
;; board: 150 x 40 mm, 6 layers: F sig / In1 GND / In2 sig / In3 +3V3 / In4 sig / B sig. Anchors by hand, the rest packed near the part they connect to.
[EcadBoard 0.0 0.0 150.0 40.0 2.0 1.6 6.0]
[EcadRules 0.15 0.15 0.45 0.25 0.3 0.15]
[EcadPour "GND" "In1.Cu"]
[EcadPour "+3V3" "In3.Cu"]
;; 12 V and 5 V carry 1-1.5 A: 0.5 mm traces (IPC-2221, 1 oz, 10 C rise)
[EcadClass "Power" 0.5 0.2 0.6 0.3]
[EcadInClass "+12V" "Power"]
[EcadInClass "+5V" "Power"]
[EcadInClass "VIN_BUCK" "Power"]
[EcadInClass "VAUX48" "Power"]
