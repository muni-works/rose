; node-full -- the 7in portrait head, generated by node_full.py; was: the cortex head as a frog node: v0 massing from NODE-BRIEF.md.
;
; A skull-shaped shell (flat face plane, domed cranium, occiput swell, neck recess), the 4in square panel as the face,
; brow cameras, a flat foot.
; The desk tilt lives in the puck, not the shell: the face is vertical on the neck, 12 deg up on the desk.
; Frame: the dock origin, centre of the foot. x fore, y left, z up, mm. Massing only: no internals, no lip, no exhaust.
; Every part is its own root (no booleans between the shell and its features) so the massing stays cheap to iterate.

[material "satin_black" 0.09 0.094 0.106 0.1 0.55]
[material "glass" 0.01 0.012 0.014 0.4 0.04]
[material "lens" 0.035 0.04 0.045 0.3 0.08]
[material "dots" 0.0 0.0 0.0 0.0 0.9]
[material "face" 0.72 0.95 0.76 0.0 0.5]
[material "puck" 0.62 0.6 0.56 0.0 0.65]
[material "body" 0.8 0.8 0.78 0.1 0.5]
[material "green" 0.3 1.0 0.45 0.0 0.4]

; cos/sin of 0, 15, ... 90 degrees (loon has no trig), and the rounded-rectangle loop from cortex.loon
[let C0 1.0] [let C1 0.965926] [let C2 0.866025] [let C3 0.707107] [let C4 0.5] [let C5 0.258819] [let C6 0.0]
[let CS #[C0 C1 C2 C3 C4 C5 C6]]
[let rr-segs [fn [cu cv a b r]
  [let ua [- [+ cu a] r]] [let ub [+ [- cu a] r]] [let va [- [+ cv b] r]] [let vb [+ [- cv b] r]]
  [let pu [fn [ox sx k fwd] [+ ox [* sx r [nth CS [if fwd k [- 6 k]]]]]]]
  [let pv [fn [oy sy k fwd] [+ oy [* sy r [nth CS [if fwd [- 6 k] k]]]]]]
  [let q [fn [ox oy sx sy fwd]
    [map [fn [k] [line [pu ox sx k fwd] [pv oy sy k fwd] [pu ox sx [+ k 1] fwd] [pv oy sy [+ k 1] fwd]]] #[0 1 2 3 4 5]]]]
  [flatten #[
    #[[line [+ cu a] vb [+ cu a] va]] [q ua va 1.0 1.0 true]
    #[[line ua [+ cv b] ub [+ cv b]]] [q ub va -1.0 1.0 false]
    #[[line [- cu a] va [- cu a] vb]] [q ub vb -1.0 -1.0 true]
    #[[line ub [- cv b] ua [- cv b]]] [q ua vb 1.0 -1.0 false]]]]]

