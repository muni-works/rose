[let full-tilt [bx -14.0 -23.0 -12.0 14.0 23.0 -1.0]]  ; tilt actuator across the neck, output on y
[let full-yoke [union [bx -20.0 -32.0 -12.0 20.0 -26.0 2.0] [bx -20.0 26.0 -12.0 20.0 32.0 2.0]]]
[let tilt 12.0] [let lift 16.0] [let on-desk [fn [s] [translate 0.0 0.0 lift [rotate 0.0 tilt 0.0 s]]]]
[let full-puck [intersection [translate -150.0 -150.0 0.0 [cube 300.0 300.0 90.0]]
  [on-desk [translate -62.0 -70.0 -40.0 [cube 124.0 140.0 40.0]]]]]
