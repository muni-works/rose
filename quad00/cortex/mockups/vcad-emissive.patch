+/// Emitted radiance multiplier from the IR: `emissive * emissive_strength`; with only a map, the map at full
+/// strength; nothing set, no emission.
+fn emissive_of(mat: Option<&vcad_ir::MaterialDef>) -> [f32; 3] {
+    let Some(m) = mat else { return [0.0; 3] };
+    if m.emissive.is_none() && m.emissive_strength.is_none() && m.emissive_map.is_none() {
+        return [0.0; 3];
+    }
+    let c = m.emissive.unwrap_or([1.0, 1.0, 1.0]);
+    let k = m.emissive_strength.unwrap_or(1.0);
+    [(c[0] * k) as f32, (c[1] * k) as f32, (c[2] * k) as f32]
