+/// An emissive image projected onto the world along a plane: texel (0,0), the image's top-left, sits at
+/// `origin`; the image's full width runs along `u`, its full height (image y, downward) along `v`.
+#[derive(Debug, PartialEq)]
+pub struct EmissiveMap {
+    pub width: usize,
+    pub height: usize,
+    /// Linear RGB, row-major from the top-left.
+    pub texels: Vec<[f32; 3]>,
+    pub origin: [f64; 3],
+    pub u: [f64; 3],
+    pub v: [f64; 3],
+}
+
+impl EmissiveMap {
+    /// The (bilinear) texel under world point `p`, or `None` outside the image.
+    pub fn sample(&self, p: [f64; 3]) -> Option<[f32; 3]> {
+        let d = [p[0] - self.origin[0], p[1] - self.origin[1], p[2] - self.origin[2]];
+        let dot = |a: [f64; 3], b: [f64; 3]| a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+        let (uu, vv) = (dot(self.u, self.u), dot(self.v, self.v));
+        if uu <= 0.0 || vv <= 0.0 || self.width == 0 || self.height == 0 {
+            return None;
+        }
+        let (s, t) = (dot(d, self.u) / uu, dot(d, self.v) / vv);
+        if !(0.0..=1.0).contains(&s) || !(0.0..=1.0).contains(&t) {
+            return None;
+        }
+        let x = (s * self.width as f64 - 0.5).clamp(0.0, (self.width - 1) as f64);
+        let y = (t * self.height as f64 - 0.5).clamp(0.0, (self.height - 1) as f64);
+        let (x0, y0) = (x.floor() as usize, y.floor() as usize);
+        let (x1, y1) = ((x0 + 1).min(self.width - 1), (y0 + 1).min(self.height - 1));
+        let (fx, fy) = ((x - x0 as f64) as f32, (y - y0 as f64) as f32);
+        let px = |xx: usize, yy: usize| self.texels[yy * self.width + xx];
+        let lerp = |a: [f32; 3], b: [f32; 3], k: f32| [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k];
+        Some(lerp(lerp(px(x0, y0), px(x1, y0), fx), lerp(px(x0, y1), px(x1, y1), fx), fy))
+    }
+}
+
+impl Pbr {
+    /// Emitted radiance at world point `p`.
+    pub fn emission_at(&self, p: [f64; 3]) -> [f32; 3] {
+        match self.emissive_map {
+            None => self.emissive,
+            Some(m) => match m.sample(p) {
+                Some(t) => [t[0] * self.emissive[0], t[1] * self.emissive[1], t[2] * self.emissive[2]],
+                None => [0.0; 3],
+            },
+        }
+    }
+}
