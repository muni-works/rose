+/// The emissive image a material asks for, decoded once per path (sRGB -> linear) and leaked so materials can
+/// hold a `&'static` (one render per process). `None` when the material has no map.
+fn emissive_map(m: &vcad_ir::MaterialDef) -> Result<Option<&'static vcad_kernel_raytrace::pathtrace::EmissiveMap>, String> {
+    use std::collections::HashMap;
+    use std::sync::{Mutex, OnceLock};
+    use vcad_kernel_raytrace::pathtrace::EmissiveMap;
+    let Some(path) = m.emissive_map.as_ref() else { return Ok(None) };
+    let (Some(origin), Some(u), Some(v)) = (m.emissive_map_origin, m.emissive_map_u, m.emissive_map_v) else {
+        return Err(format!("material '{}': emissive map needs origin, u and v", m.name));
+    };
+    static CACHE: OnceLock<Mutex<HashMap<String, &'static EmissiveMap>>> = OnceLock::new();
+    let key = format!("{path}|{origin:?}|{u:?}|{v:?}");
+    let mut cache = CACHE.get_or_init(|| Mutex::new(HashMap::new())).lock().map_err(|e| e.to_string())?;
+    if let Some(hit) = cache.get(&key) {
+        return Ok(Some(*hit));
+    }
+    let img = image::open(path).map_err(|e| format!("material '{}': emissive map {path}: {e}", m.name))?.to_rgb8();
+    let lin = |c: u8| {
+        let c = c as f32 / 255.0;
+        if c <= 0.04045 { c / 12.92 } else { ((c + 0.055) / 1.055).powf(2.4) }
+    };
+    let map: &'static EmissiveMap = Box::leak(Box::new(EmissiveMap {
+        width: img.width() as usize,
+        height: img.height() as usize,
+        texels: img.pixels().map(|p| [lin(p[0]), lin(p[1]), lin(p[2])]).collect(),
+        origin,
+        u,
+        v,
+    }));
+    cache.insert(key, map);
+    Ok(Some(map))
 }
