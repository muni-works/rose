; The printed node assembled: tub + floor/sled (from node_print.py) with the internals and face from node.loon.
[use node [node-glass node-face node-lenses node-battery node-carrier node-module node-heatsink node-display node-cam-l node-cam-r node-lens-l node-lens-r node-power node-speakers node-usb-c node-dockboard]]
[material "satin_black" 0.035 0.037 0.042 0.05 0.6] [material "petg_grey" 0.42 0.44 0.47 0.1 0.5]
[material "glass" 0.01 0.012 0.014 0.4 0.04] [material "face" 0.72 0.95 0.76 0.0 0.5] [material "lens" 0.035 0.04 0.045 0.3 0.08]
[material "pcb_green" 0.05 0.32 0.18 0.1 0.45] [material "cell_pack" 0.13 0.22 0.42 0.1 0.5] [material "heatsink" 0.55 0.57 0.6 0.7 0.4]
[root [import-mesh "node-tub.stl" :units "mm"] "satin_black"]
[root [import-mesh "node-floor.stl" :units "mm"] "petg_grey"]
[root node-glass "glass"] [root node-face "face"] [root node-lenses "lens"]
[root node-battery "cell_pack"] [root node-carrier "pcb_green"] [root node-module "pcb_green"] [root node-heatsink "heatsink"]
[root node-display "heatsink"] [root node-cam-l "pcb_green"] [root node-cam-r "pcb_green"] [root node-lens-l "lens"] [root node-lens-r "lens"] [root node-power "pcb_green"]
[root node-speakers "heatsink"] [root node-usb-c "heatsink"] [root node-dockboard "pcb_green"]
