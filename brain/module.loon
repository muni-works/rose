;; rose brain module v0 (split.py from brain.loon) - generated by gen_brain.py from its tables; edit there, not here.
[let part [fn [ref lib val fp pins]
  #[[EcadSymbol ref lib val fp 0.0 0.0 0.0]
    [map [fn [pn] [EcadConn [nth pn 1] [str ref "." [nth pn 0]]]] [chunk 2 pins]]]]]
;; SoC section after Radxa ROCK 5C v1.1; see DESIGN.md.

;; ---- power in: 12 V and the BMS CAN bus from the power spine, on one XT30(2+2)
;; realtime domain, held up: a diode keeps its reservoir from feeding the SoC rails, so the H7
;; finishes the black-box write after the 12 V input dies (PFAIL warns it)
;; 12V_RT -> 5V_RT (1 A, LMR33610) -> 3V3_RT (AP2112): H7, CAN, flash
;; 12V -> VCC_SYSIN 5 V (4 A, LMR33640): the PMIC and RK860 input, as ROCK 5C's USB-C 5 V
[part "C24" "Device:C" "22u" "Capacitor_SMD:C_0603_1608Metric"
  #["1" "VCC_SYSIN" "2" "GND"]]
[part "C25" "Device:C" "22u" "Capacitor_SMD:C_0603_1608Metric"
  #["1" "VCC_SYSIN" "2" "GND"]]
[part "C26" "Device:C" "22u" "Capacitor_SMD:C_0603_1608Metric"
  #["1" "VCC_SYSIN" "2" "GND"]]
[part "C27" "Device:C" "100n" "Capacitor_SMD:C_0402_1005Metric"
  #["1" "VCC_SYSIN" "2" "GND"]]
[part "PF4" "power:PWR_FLAG" "PWR_FLAG" ""
  #["1" "VCC_SYSIN"]]

