;; ---- STM32H723VG: S0 at 1 kHz, the body clock, 6 CAN-FD buses, the black box
[part "R80" "Device:R" "10k" "Resistor_SMD:R_0402_1005Metric"
  #["1" "RT_BOOT0" "2" "GND"]]
;; black-box flash: 16 MB, the last minutes of every bus frame and command
;; ---- six CAN-FD buses: 0-2 on the H7's FDCANs, 3-4 on MCP251863s, 5 (BMS) on the third MCP251863
;; limb port: GH 5-pin, CAN_H, CAN_L, SYNC, ESTOP_OK, GND (power comes from the spine on its own XT30)
;; power flags: rails a regulator or PMIC output drives (KiCad types those pins as inputs or passives)
