;; rose brain carrier v0 (split.py from brain.loon) - generated by gen_brain.py from its tables; edit there, not here.
[let part [fn [ref lib val fp pins]
  #[[EcadSymbol ref lib val fp 0.0 0.0 0.0]
    [map [fn [pn] [EcadConn [nth pn 1] [str ref "." [nth pn 0]]]] [chunk 2 pins]]]]]
;; SoC section after Radxa ROCK 5C v1.1; see DESIGN.md.

;; ---- power in: 12 V and the BMS CAN bus from the power spine, on one XT30(2+2)
[part "J1" "Connector_Generic:Conn_01x04" "XT30PB(2+2)-M 12V + BMS CAN from spine" "art:AMASS_XT30PB_2+2_M"
  #["1" "12V_IN" "2" "GND" "3" "CAN5_H" "4" "CAN5_L"]]
[part "F1" "Device:Polyfuse" "6A hold 16V (1812)" "Fuse:Fuse_1812_4532Metric"
  #["1" "12V_IN" "2" "12V"]]
[part "D1" "Device:D_TVS" "SMBJ15A" "Diode_SMD:D_SMB"
  #["1" "GND" "2" "12V"]]
[part "C1" "Device:C" "10u 25V" "Capacitor_SMD:C_0603_1608Metric"
  #["1" "12V" "2" "GND"]]
[part "C2" "Device:C" "10u 25V" "Capacitor_SMD:C_0603_1608Metric"
  #["1" "12V" "2" "GND"]]
[part "PF1" "power:PWR_FLAG" "PWR_FLAG" ""
  #["1" "12V"]]
[part "PF2" "power:PWR_FLAG" "PWR_FLAG" ""
  #["1" "GND"]]
[part "J2" "Connector_Generic:Conn_01x03" "GH e-stop + pack status from spine" "Connector_JST:JST_GH_SM03B-GHS-TB_1x03-1MP_P1.25mm_Horizontal"
  #["1" "ESTOP_OK" "2" "PACK_OK" "3" "GND"]]
[part "R1" "Device:R" "10k" "Resistor_SMD:R_0402_1005Metric"
  #["1" "ESTOP_OK" "2" "GND"]]
[part "R2" "Device:R" "10k" "Resistor_SMD:R_0402_1005Metric"
  #["1" "PACK_OK" "2" "GND"]]
;; realtime domain, held up: a diode keeps its reservoir from feeding the SoC rails, so the H7
;; finishes the black-box write after the 12 V input dies (PFAIL warns it)
[part "D2" "Device:D_Schottky" "SS34" "Diode_SMD:D_SMA"
  #["1" "12V_RT" "2" "12V"]]
[part "C3" "Device:C_Polarized" "470u 25V" "Capacitor_SMD:CP_Elec_8x10.5"
