;; ---- RK806-1 PMIC (ROCK 5C sheet 24)
[part "SW1" "Switch:SW_Push" "power key" "Button_Switch_SMD:SW_SPST_TL3342"
  #["1" "PWRON_L" "2" "GND"]]
;; ---- RK860 bucks for the big cores and NPU, on I2C (ROCK 5C sheet 23)
;; VCC_1V1_NLDO_S3 (SY8089, sheet 23) and the switched VCC_3V3_S0 (SGM2576)
;; ---- RK3588S2: power map by ball name (ROCK 5C sheets 4-11)
;; clock, reset, boot (sheets 5, 8)
[part "SW2" "Switch:SW_Push" "maskrom/recovery" "Button_Switch_SMD:SW_SPST_TL3342"
  #["1" "RECOVERY_KEY" "2" "GND"]]
;; ---- LPDDR4X: CH0 -> U_DRAM0, CH1 -> U_DRAM1; SoC sub-channel A/C -> DRAM a, B/D -> b (sheet 12)
;; ---- eMMC (sheet 21): HS400, 1.8 V IO
;; ---- USB-C (OTG0, USB 2.0): maskrom flashing, USB gadget Ethernet to a dev machine
[part "J3" "Connector:USB_C_Receptacle_USB2.0_16P" "USB-C (device)" "Connector_USB:USB_C_Receptacle_GCT_USB4105-xx-A_16P_TopMnt_Horizontal"
  #["S1" "GND" "A1" "GND" "A12" "GND" "B1" "GND" "B12" "GND" "A4" "USB_VBUS" "A9" "USB_VBUS" "B4" "USB_VBUS" "B9" "USB_VBUS" "A5" "USB_CC1" "B5" "USB_CC2" "A7" "USB_C_DM" "B7" "USB_C_DM" "A6" "USB_C_DP" "B6" "USB_C_DP"]]
[part "R72" "Device:R" "5.1k" "Resistor_SMD:R_0402_1005Metric"
  #["1" "USB_CC1" "2" "GND"]]
[part "R73" "Device:R" "5.1k" "Resistor_SMD:R_0402_1005Metric"
  #["1" "USB_CC2" "2" "GND"]]
[part "U9" "Power_Protection:USBLC6-2SC6" "USBLC6-2SC6" "Package_TO_SOT_SMD:SOT-23-6"
  #["1" "USB_C_DP" "6" "USB_OTG_DP" "3" "USB_C_DM" "4" "USB_OTG_DM" "2" "GND" "5" "USB_VBUS"]]
;; PCIe 2.0 (PCIE20_0) is left free for v1: an M.2 slot (NVMe / Hailo-8) needs a socket footprint we have not drawn yet
;; ---- cameras: CSI0 (4-lane) and DPHY0 RX (4-lane) to Pi-style 22-pin FPCs; triggers from the H7 clock
[part "J5" "Connector_Generic_MountingPin:Conn_01x22_MountingPin" "camera 0 (22-pin 0.5 mm, Pi CSI-2 4-lane)" "Connector_FFC-FPC:Hirose_FH12-22S-0.5SH_1x22-1MP_P0.50mm_Horizontal"
