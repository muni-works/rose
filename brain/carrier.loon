  #["1" "GND" "2" "CAM1_D0N" "3" "CAM1_D0P" "4" "GND" "5" "CAM1_D1N" "6" "CAM1_D1P" "7" "GND" "8" "CAM1_CN" "9" "CAM1_CP" "10" "GND" "11" "CAM1_D2N" "12" "CAM1_D2P" "13" "GND" "14" "CAM1_D3N" "15" "CAM1_D3P" "16" "GND" "17" "CAM1_PWDN" "18" "CAM1_TRIG" "19" "GND" "20" "CAM1_SCL" "21" "CAM1_SDA" "22" "VCC_3V3_S0" "MP" "GND"]]
;; ---- SoC <-> H7: SPI0_M2 (SoC master, 1 kHz bus exchange), UART6_M1 (H7 bootloader + console), IRQ, reset, BOOT0
[part "J7" "Connector_Generic:Conn_01x03" "SoC console (UART2, 1.5 Mbaud)" "Connector_JST:JST_GH_SM03B-GHS-TB_1x03-1MP_P1.25mm_Horizontal"
