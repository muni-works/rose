; ══ K1-scale humanoid — sheet-metal structure, 22 DOF ══
[assembly
  #[
    [part "torso"
      [union [shell 2 [translate -92 -60 -46 [cube 184 120 92]]]
             [shell 2 [translate -105 -65 44 [cube 210 130 238]]]] "aluminum"]

    [part "neck" [union [cylinder 22 46] [cylinder 27 34]] "abs-black"]
    [part "head" [union [rotate 90 0 0 [translate 0 0 -20 [cylinder 22 40]]]
                        [union [translate -52 -70 60 [cube 104 12 34]]
                               [shell 2 [translate -65 -62 -4 [cube 130 124 120]]]]] "abs-black"]

    [part "sh-yoke" [rotate 90 0 0 [translate 0 0 -25 [cylinder 27 50]]] "abs-black"]
    [part "uarm" [union [rotate 0 90 0 [translate 0 0 -25 [cylinder 27 50]]]
                        [difference [translate -20 -20 -176 [cube 40 54 168]]
                                    [translate -22 -22 -178 [cube 44 44 172]]]] "aluminum"]
    [part "farm" [union [rotate 90 0 0 [translate 0 0 -25 [cylinder 27 50]]]
                        [difference [translate -17 -20 -166 [cube 34 54 158]]
                                    [translate -19 -22 -168 [cube 38 44 162]]]] "aluminum"]
    [part "hand" [union [cylinder 22 20]
                        [fillet 8 [translate -24 -13 -100 [cube 48 26 100]]]] "abs-black"]

    [part "hipy" [translate 0 0 -25 [cylinder 27 50]] "abs-black"]
    [part "hipr" [rotate 0 90 0 [translate 0 0 -29 [cylinder 35 58]]] "abs-black"]
    [part "thigh" [union [rotate 90 0 0 [translate 0 0 -29 [cylinder 35 58]]]
                         [difference [translate -34 -28 -202 [cube 68 70 196]]
                                     [translate -36 -30 -204 [cube 72 60 200]]]] "aluminum"]
    [part "shin" [union [rotate 90 0 0 [translate 0 0 -29 [cylinder 35 58]]]
                        [difference [translate -29 -26 -206 [cube 58 66 200]]
                                    [translate -31 -28 -208 [cube 62 56 204]]]] "aluminum"]
    [part "ankp" [rotate 90 0 0 [translate 0 0 -25 [cylinder 27 50]]] "abs-black"]
    [part "foot" [union [rotate 0 90 0 [translate 0 0 -20 [cylinder 22 40]]]
                        [fillet 5 [translate -35 -70 -40 [cube 70 155 25]]]] "abs-black"]
  ]

  #[
    [instance "i-torso" "torso" 0 0 508]
    [instance "i-neck" "neck" 0 0 786]        [instance "i-head" "head" 0 0 832]
    [instance "i-sh-r" "sh-yoke" 132 0 762]   [instance "i-uarm-r" "uarm" 132 0 762]
    [instance "i-farm-r" "farm" 132 0 582]    [instance "i-hand-r" "hand" 132 0 412]
    [instance "i-sh-l" "sh-yoke" -132 0 762]  [instance "i-uarm-l" "uarm" -132 0 762]
    [instance "i-farm-l" "farm" -132 0 582]   [instance "i-hand-l" "hand" -132 0 412]
    [instance "i-hipy-r" "hipy" 60 0 468]     [instance "i-hipr-r" "hipr" 60 0 468]
    [instance "i-thigh-r" "thigh" 60 0 468]   [instance "i-shin-r" "shin" 60 0 260]
    [instance "i-ankp-r" "ankp" 60 0 48]      [instance "i-foot-r" "foot" 60 0 40]
    [instance "i-hipy-l" "hipy" -60 0 468]    [instance "i-hipr-l" "hipr" -60 0 468]
    [instance "i-thigh-l" "thigh" -60 0 468]  [instance "i-shin-l" "shin" -60 0 260]
    [instance "i-ankp-l" "ankp" -60 0 48]     [instance "i-foot-l" "foot" -60 0 40]
  ]

  #[
    [revolute-joint "neck-yaw"   0 0 1 -90 90  "i-torso" 0 0 278  "i-neck" 0 0 0]
    [revolute-joint "head-pitch" 0 1 0 -35 35  "i-neck"  0 0 46   "i-head" 0 0 0]

    [revolute-joint "r-sh-pitch" 0 1 0 -180 60 "i-torso" 132 0 254 "i-sh-r" 0 0 0]
    [revolute-joint "r-sh-roll"  1 0 0 -100 15 "i-sh-r" 0 0 0      "i-uarm-r" 0 0 0]
    [revolute-joint "r-elbow"    0 1 0 -120 5  "i-uarm-r" 0 0 -180 "i-farm-r" 0 0 0]
    [revolute-joint "r-wrist"    0 0 1 -90 90  "i-farm-r" 0 0 -170 "i-hand-r" 0 0 0]
    [revolute-joint "l-sh-pitch" 0 1 0 -180 60 "i-torso" -132 0 254 "i-sh-l" 0 0 0]
    [revolute-joint "l-sh-roll"  1 0 0 -15 100 "i-sh-l" 0 0 0      "i-uarm-l" 0 0 0]
    [revolute-joint "l-elbow"    0 1 0 -120 5  "i-uarm-l" 0 0 -180 "i-farm-l" 0 0 0]
    [revolute-joint "l-wrist"    0 0 1 -90 90  "i-farm-l" 0 0 -170 "i-hand-l" 0 0 0]

    [revolute-joint "r-hip-yaw"   0 0 1 -45 45  "i-torso" 60 0 -40 "i-hipy-r" 0 0 0]
    [revolute-joint "r-hip-roll"  1 0 0 -30 45  "i-hipy-r" 0 0 0   "i-hipr-r" 0 0 0]
    [revolute-joint "r-hip-pitch" 0 1 0 -120 60 "i-hipr-r" 0 0 0   "i-thigh-r" 0 0 0]
    [revolute-joint "r-knee"      0 1 0 0 135   "i-thigh-r" 0 0 -208 "i-shin-r" 0 0 0]
    [revolute-joint "r-ank-pitch" 0 1 0 -45 30  "i-shin-r" 0 0 -212 "i-ankp-r" 0 0 0]
    [revolute-joint "r-ank-roll"  1 0 0 -25 25  "i-ankp-r" 0 0 -8   "i-foot-r" 0 0 0]
    [revolute-joint "l-hip-yaw"   0 0 1 -45 45  "i-torso" -60 0 -40 "i-hipy-l" 0 0 0]
    [revolute-joint "l-hip-roll"  1 0 0 -45 30  "i-hipy-l" 0 0 0   "i-hipr-l" 0 0 0]
    [revolute-joint "l-hip-pitch" 0 1 0 -120 60 "i-hipr-l" 0 0 0   "i-thigh-l" 0 0 0]
    [revolute-joint "l-knee"      0 1 0 0 135   "i-thigh-l" 0 0 -208 "i-shin-l" 0 0 0]
    [revolute-joint "l-ank-pitch" 0 1 0 -45 30  "i-shin-l" 0 0 -212 "i-ankp-l" 0 0 0]
    [revolute-joint "l-ank-roll"  1 0 0 -25 25  "i-ankp-l" 0 0 -8   "i-foot-l" 0 0 0]
  ]

  "i-torso"]
