; rose-pro SKIN layer. GENERATED by pro/skin.py - edit the panel table there.
; [skin r :gap g bones...] is the rolling-ball wrap: min curvature radius
; r everywhere, standing g off the bones. r and the cobot contact rule are
; the same number.
[material "skin" 0.82 0.80 0.76 0.35 0.15]

[use actuators [act_C_head_pitch act_C_waist_yaw act_L_ank_mA act_L_ank_mB act_L_ank_roll act_L_elb_pitch act_L_hip_pitch act_L_hip_roll act_L_hip_yaw act_L_knee act_L_sho_roll act_L_wrist_yaw act_R_ank_mA act_R_ank_mB act_R_ank_roll act_R_elb_pitch act_R_hip_pitch act_R_hip_roll act_R_hip_yaw act_R_knee act_R_sho_roll act_R_wrist_yaw]]
[use links.ankle [L_ankle_jaw_fr L_ankle_jaw_rr L_ankle_spine R_ankle_jaw_fr R_ankle_jaw_rr R_ankle_spine]]
[use links.crankA [L_crankA_bar R_crankA_bar]]
[use links.crankB [L_crankB_bar R_crankB_bar]]
[use links.elbA [L_elbA_elb_out L_elbA_hem_fr L_elbA_hem_rr L_elbA_shell L_elbA_shell_chf L_elbA_wall_fr L_elbA_wall_lo_fr L_elbA_wall_lo_rr L_elbA_wall_rr L_elbA_wrist_face R_elbA_elb_out R_elbA_hem_fr R_elbA_hem_rr R_elbA_shell R_elbA_shell_chf R_elbA_wall_fr R_elbA_wall_lo_fr R_elbA_wall_lo_rr R_elbA_wall_rr R_elbA_wrist_face]]
[use links.foot [L_foot_col_foot L_foot_column L_foot_heel L_foot_sole L_foot_toe L_foot_wall_in L_foot_wall_out R_foot_col_foot R_foot_column R_foot_heel R_foot_sole R_foot_toe R_foot_wall_in R_foot_wall_out]]
[use links.hand [L_hand_back L_hand_chamfer L_hand_hem_back L_hand_hem_palm L_hand_palm L_hand_thumb_bot L_hand_thumb_out L_hand_thumb_top L_hand_wrist_out R_hand_back R_hand_chamfer R_hand_hem_back R_hand_hem_palm R_hand_palm R_hand_thumb_bot R_hand_thumb_out R_hand_thumb_top R_hand_wrist_out]]
[use links.head [C_head_crown_bk C_head_crown_fr C_head_crown_top C_head_eyes C_head_face C_head_flank_l C_head_flank_r C_head_hp_out C_head_jaw C_head_rear C_head_shelf C_head_visor_hem]]
