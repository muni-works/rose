[use actuators [act_C_head_pitch act_C_waist_yaw act_L_ank_mA act_L_ank_mB act_L_ank_roll act_L_elb_pitch act_L_hip_yaw act_L_knee act_L_wrist_yaw act_R_ank_mA act_R_ank_mB act_R_ank_roll act_R_elb_pitch act_R_hip_yaw act_R_knee act_R_wrist_yaw]]
