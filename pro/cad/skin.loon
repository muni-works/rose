[use links.hipB [L_hipB_bridge L_hipB_leg L_hipB_roll_out L_hipB_yaw_face R_hipB_bridge R_hipB_leg R_hipB_roll_out R_hipB_yaw_face]]
[use links.neck [C_neck_foot C_neck_hp_face C_neck_hy_out]]
[use links.pelvisC [C_pelvisC_front_ch C_pelvisC_front_lo C_pelvisC_rear_ch C_pelvisC_rear_lo C_pelvisC_top]]
[use links.pelvisS [L_pelvisS_hip_mount R_pelvisS_hip_mount]]
[use links.shank [L_shank_calf_front L_shank_calf_in L_shank_calf_lap_bot L_shank_calf_lap_top L_shank_calf_taper L_shank_flange_fr L_shank_fork_bridge_in L_shank_fork_bridge_out L_shank_fork_in L_shank_fork_lap_in L_shank_fork_lap_out L_shank_fork_out L_shank_web R_shank_calf_front R_shank_calf_in R_shank_calf_lap_bot R_shank_calf_lap_top R_shank_calf_taper R_shank_flange_fr R_shank_fork_bridge_in R_shank_fork_bridge_out R_shank_fork_in R_shank_fork_lap_in R_shank_fork_lap_out R_shank_fork_out R_shank_web]]
[use links.shoA [L_shoA_bendtab L_shoA_bendtab_2 L_shoA_shop_out L_shoA_shor_face R_shoA_bendtab R_shoA_bendtab_2 R_shoA_shop_out R_shoA_shor_face]]
[use links.shoB [L_shoB_elb_face L_shoB_elb_lap L_shoB_elb_shelf L_shoB_flange_fr L_shoB_flange_rr L_shoB_hem_fr L_shoB_hem_rr L_shoB_shor_out L_shoB_web R_shoB_elb_face R_shoB_elb_lap R_shoB_elb_shelf R_shoB_flange_fr R_shoB_flange_rr R_shoB_hem_fr R_shoB_hem_rr R_shoB_shor_out R_shoB_web]]
[use links.thigh [L_thigh_flange_in L_thigh_flange_out L_thigh_hem_in L_thigh_hem_out L_thigh_knee_face L_thigh_knee_shroud-20 L_thigh_knee_shroud100 L_thigh_knee_shroud20 L_thigh_knee_shroud60 L_thigh_shelf L_thigh_top L_thigh_web L_thigh_web_lo L_thigh_yaw_out R_thigh_flange_in R_thigh_flange_out R_thigh_hem_in R_thigh_hem_out R_thigh_knee_face R_thigh_knee_shroud-20 R_thigh_knee_shroud100 R_thigh_knee_shroud20 R_thigh_knee_shroud60 R_thigh_shelf R_thigh_top R_thigh_web R_thigh_web_lo R_thigh_yaw_out]]
[use links.trunkC [C_trunkC_deck C_trunkC_floor C_trunkC_front_hem C_trunkC_front_lo C_trunkC_front_up C_trunkC_rear_hem C_trunkC_rear_lo C_trunkC_rear_up]]
[use links.trunkS [L_trunkS_outrigger L_trunkS_sho_chamfer L_trunkS_sho_stat L_trunkS_side L_trunkS_side_hem L_trunkS_waist L_trunkS_waist_chamfer R_trunkS_outrigger R_trunkS_sho_chamfer R_trunkS_sho_stat R_trunkS_side R_trunkS_side_hem R_trunkS_waist R_trunkS_waist_chamfer]]

[let skin_L_thigh
